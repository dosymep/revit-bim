<Project>
    <PropertyGroup>
        <Version>2.0.0</Version>
        <FileVersion>2.0.0</FileVersion>
    </PropertyGroup>

    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>

        <Company>dosymep</Company>
        <Authors>dosymep</Authors>
        <Copyright>Copyright © $([System.DateTime]::Now.ToString('yyyy'))</Copyright>

        <RepositoryType>Git</RepositoryType>
        <RepositoryUrl>https://github.com/dosymep/revit-dotbim</RepositoryUrl>
        <PackageProjectUrl>https://github.com/dosymep/revit-dotbim.git</PackageProjectUrl>
    </PropertyGroup>
</Project>
