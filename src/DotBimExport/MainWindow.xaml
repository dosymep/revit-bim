<Window
    x:Class="DotBimExport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:DotBimExport.Behaviors"
    xmlns:res="clr-namespace:DotBimExport.Resources"
    xmlns:vms="clr-namespace:DotBimExport.ViewModels"

    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"

    x:Name="_this"
    mc:Ignorable="d"

    Title="{x:Static res:Strings.MainWindowTitle}"

    Width="300"
    Height="350"

    MinWidth="300"
    MinHeight="350"

    d:DataContext="{d:DesignInstance vms:MainViewModel, IsDesignTimeCreatable=False}">

    <b:Interaction.Behaviors>
        <behaviors:LoadedBehavior Command="{Binding LoadViewCommand}" />
    </b:Interaction.Behaviors>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Text="{x:Static res:Strings.View}" />

        <ComboBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,8"
            ItemsSource="{Binding Views}"
            SelectedItem="{Binding SelectedView}"
            DisplayMemberPath="Name" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Text="{x:Static res:Strings.NameLanguage}" />

        <ComboBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,8"
            ItemsSource="{Binding Languages}"
            SelectedItem="{Binding NameLanguage}"
            DisplayMemberPath="Name" />

        <CheckBox
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8"
            Content="{x:Static res:Strings.ExportElementInfo}"
            IsChecked="{Binding ExportElementInfo}" />

        <CheckBox
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8"
            Content="{x:Static res:Strings.ExportLinks}"
            IsChecked="{Binding ExportLinks}" />

        <DockPanel
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,4"
            LastChildFill="False">
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Static res:Strings.Categories}" />

            <Button
                Margin="12,0,0,0"
                Content="{x:Static res:Strings.SelectAll}"
                Command="{Binding SelectAllCategoriesCommand}" />

            <Button
                Margin="8,0,0,0"
                Content="{x:Static res:Strings.ClearSelection}"
                Command="{Binding ClearCategoriesCommand}" />
        </DockPanel>

        <ScrollViewer
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,12"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{Binding Name}"
                            IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel
            Grid.Row="6"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Width="90"
                Margin="0,0,8,0"
                Content="{x:Static res:Strings.Export}"
                IsDefault="True"
                Command="{Binding AcceptViewCommand}" />

            <Button
                Width="90"
                Content="{x:Static res:Strings.Cancel}"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
